{
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "shine.events"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Jwt": {
    "Issuer": "Shine",
    "Audience": "Shine.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "ClockSkewSeconds": 30
  },
  "AuthenticationRateLimiting": {
    "Login": { "PermitLimit": 10, "Window": "00:01:00" },
    "Registration": { "PermitLimit": 5, "Window": "00:05:00" },
    "Refresh": { "PermitLimit": 30, "Window": "00:01:00" },
    "PasswordRecovery": { "PermitLimit": 5, "Window": "00:15:00" }
  },
  "TrustedProxies": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "PasswordRecovery": {
    "BaseUrl": "https://app.local"
  },
  "AllowedHosts": "*"
}
