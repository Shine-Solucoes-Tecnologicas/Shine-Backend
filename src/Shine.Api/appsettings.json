{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": true
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "PasswordRecovery": {
    "BaseUrl": "https://app.local"
  },
  "AllowedHosts": "*"
}
